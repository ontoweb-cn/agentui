# =============================================================================
# 子目录部署运行时环境变量示例(方案 A)
# 复制为 .env 并按需修改:cp .env.subpath.example .env
# =============================================================================

# 子目录名(必须与镜像构建时 --build-arg SUBPATH 一致,不带前后斜杠)
SUBPATH=agentui

# ---- BFF ----
BFF_PORT=9390
# OAuth 登录成功后重定向前端首页(默认 /${SUBPATH}/,entrypoint 自动注入)
BFF_OAUTH_FRONTEND_HOME=/agentui/

# OAuth 回调后重定向前端首页(默认 /)
# BFF_OAUTH_FRONTEND_HOME=/
# cookie 路径(可选,默认 /;同域多应用建议设为 /agentui)
BFF_COOKIE_PATH=/agentui

# ---- intellect-rag 后端 ----
INTELLECT_RAG_HOST=intellect-rag
PYTHON_API_PORT=9380
PYTHON_ADMIN_PORT=9381

# ---- cognitive-wargame 后端 ----
WARGAME_HOST=wargame-service
WARGAME_PORT=9385

# ---- 凭据(按需) ----
# Intellect RAG admin token(画布/知识库后端)
HARNESS_INTELLECT_RAG_ADMIN_TOKEN=
# Intellect 企业版 API_SERVER_KEY
HARNESS_INTELLECT_ENTERPRISE_API_SERVER_KEY=
# Intellect LLM Gateway API Key
INTELLECT_LLM_API_KEY=

# ---- SSRF 防护 ----
# 是否允许向私有网段发起请求(内部部署建议 true)
SSRF_ALLOW_PRIVATE_IP=false

# ---- CORS ----
# 允许的前端来源(逗号分隔)
CORS_ALLOWED_ORIGINS=https://example.com
