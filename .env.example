# SPA 基础路径
VITE_BASE_URL=/

# 后端地址（开发时 Vite 代理目标）
API_HOST=localhost
PYTHON_API_PORT=9380
PYTHON_ADMIN_PORT=9381

# cognitive-wargame 推演管理服务（wargamesrv）地址。
# 前端经统一前缀 /api/v1/wargame/* 访问，Vite proxy / Nginx rewrite 去掉
# /wargame 前缀后转发到 WARGAME_HOST:WARGAME_PORT（后端监听 /api/v1/*）。
WARGAME_HOST=localhost
WARGAME_PORT=9385

# BFF（默认与前端同机;远程开发时可设为 BFF 所在主机 IP）
BFF_HOST=localhost
BFF_PORT=9390

# OpenAPI 类型生成
OPENAPI_SPEC_URL=http://localhost:9380/api/v1/openapi.json

# 构建
VITE_BUILD_SOURCEMAP=false
VITE_MINIFY=terser

# ---------------------------------------------------------------------------
# Multi-Harness P0 (Constitution Principle VIII v1.1.0)
# ---------------------------------------------------------------------------
# Intellect RAG admin token (画布/知识库后端)
HARNESS_INTELLECT_RAG_ADMIN_TOKEN=
# Intellect 企业版 (intellect-team) API_SERVER_KEY (P0-P3 统一鉴权,实例内 Team/Project 数据隔离靠 X-Intellect-Team/X-Intellect-Project 头;真正租户隔离通过多实例部署)
HARNESS_INTELLECT_ENTERPRISE_API_SERVER_KEY=
# 前端 BFF 反向代理基路径 (P0-前置,前端所有 /api/v1/* 改经 BFF 透传)
VITE_BFF_BASE=/api/bff

# ---------------------------------------------------------------------------
# Multi-Harness P4b (BFF 统一认证路由)
# ---------------------------------------------------------------------------
# 注意:企业版 baseUrl 不从此处读取,而是从 HarnessStore 按 tenant.intellectBackendId
# 读取对应 intellect-team 实例的 endpoint(多实例多租户隔离,见 spec FR-014)。
# harnessStore 配置文件:bff/config/harness-backends.json(每个 backend 含 id/endpoint/adminTokenEnvVar)
# OAuth 回调后重定向前端首页(默认 /)
BFF_OAUTH_FRONTEND_HOME=/
# Intellect RAG 后端地址(社区版认证透传用)
INTELLECT_RAG_HOST=localhost
PYTHON_API_PORT=9380
