# SPA 基础路径
VITE_BASE_URL=/

# 后端地址（开发时 Vite 代理目标）
API_HOST=localhost
PYTHON_API_PORT=9380
PYTHON_ADMIN_PORT=9381

# BFF
BFF_PORT=9390

# OpenAPI 类型生成
OPENAPI_SPEC_URL=http://localhost:9380/api/v1/openapi.json

# 构建
VITE_BUILD_SOURCEMAP=false
VITE_MINIFY=terser

# ---------------------------------------------------------------------------
# Multi-Harness P0 (Constitution Principle VIII v1.1.0)
# ---------------------------------------------------------------------------
# Intellect RAG admin token (单租户场景,画布/知识库后端)
HARNESS_INTELLECT_RAG_ADMIN_TOKEN=
# Intellect 企业版 (intellect-team) API_SERVER_KEY (P0-P3 统一鉴权,多租户靠 X-Intellect-Team/X-Intellect-Project 头)
HARNESS_INTELLECT_ENTERPRISE_API_SERVER_KEY=
# 前端 BFF 反向代理基路径 (P0-前置,前端所有 /api/v1/* 改经 BFF 透传)
VITE_BFF_BASE=/api/bff
