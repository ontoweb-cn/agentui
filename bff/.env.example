# BFF 运行时环境变量(本地开发)
# 复制本文件为 .env 并按需填写:cp .env.example .env

BFF_PORT=9390

# Intellect RAG admin token(画布/知识库后端)
# 留空以模拟"Backend 未配置"场景,触发 Wizard 向导流程
HARNESS_INTELLECT_RAG_ADMIN_TOKEN=
# Intellect 企业版 API_SERVER_KEY
HARNESS_INTELLECT_ENTERPRISE_API_SERVER_KEY=
# Intellect LLM Gateway API Key
INTELLECT_LLM_API_KEY=

# 前端 BFF 反向代理基路径
VITE_BFF_BASE=/api/bff

# OAuth 回调后重定向前端首页
BFF_OAUTH_FRONTEND_HOME=/

# Intellect RAG 后端地址(社区版认证透传用)
INTELLECT_RAG_HOST=localhost
PYTHON_API_PORT=9380
PYTHON_ADMIN_PORT=9381

# CORS 允许的前端来源(逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9391

# SSRF 防护:是否允许向私有网段(10.x / 172.16-31.x / 192.168.x / 127.x / 169.254.x)发起请求
# 内部/实验室部署的后端通常位于私有网段,设为 true 放行 wizard 探测与 setup。
# 默认 false(拦截);公网暴露的 BFF 切勿开启。
SSRF_ALLOW_PRIVATE_IP=false
