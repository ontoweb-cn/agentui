# BFF 运行时环境变量(本地开发)
# 复制本文件为 .env 并按需填写:cp .env.example .env

BFF_PORT=9390

# Intellect RAG admin token(画布/知识库后端)
# 留空以模拟"Backend 未配置"场景,触发 Wizard 向导流程
HARNESS_INTELLECT_RAG_ADMIN_TOKEN=
# Intellect 企业版 API_SERVER_KEY
HARNESS_INTELLECT_ENTERPRISE_API_SERVER_KEY=
# Intellect LLM Gateway API Key
INTELLECT_LLM_API_KEY=

# 前端 BFF 反向代理基路径
VITE_BFF_BASE=/api/bff

# OAuth 回调后重定向前端首页
BFF_OAUTH_FRONTEND_HOME=/
# 本 BFF 的公开 OAuth 回调 URL(F-CB-01 修复):发起 SSO 时显式传给 intellect-team,
# 使 IdP 回调落回 BFF /api/bff/auth/oauth/callback。生产必须配置(防 Host 伪造);
# 缺省按请求转发头(X-Forwarded-Proto/Host)推导。该 URL 必须已在 IdP 应用
# redirectUris 白名单中登记(存量环境用 intellect-auth 仓 scripts/migrate-sso-apps.sh
# 的 IA_REDIRECT_URI 幂等补登)。配置形态自检:值未以 /api/bff/auth/oauth/callback
# 结尾时启动后首次调用会告警一次(评审 F-Q4,最终仍由 IdP 白名单 fail-closed)。
BFF_OAUTH_REDIRECT_URI=

# --- spec-014 P2:SSO（BFF 作为 OIDC RP）---
# 总开关；false 时保持旧网关回调链路（回滚用）
BFF_SSO_ENABLED=false
# 签名 state Cookie 密钥，启用时必填，>=32 字符；多副本必须一致
BFF_SSO_STATE_SECRET=
# 对外访问源（用于拼 redirect_uri），启用时必填；生产必须 https
BFF_PUBLIC_ORIGIN=
# 前端基路径（子目录部署时填写，如 /agentui；缺省根路径）
BFF_FRONTEND_BASE=
# 全局应急名单（逗号分隔）；空 = 完全以网关 enabled/usage 为准
BFF_SSO_PROVIDERS=
# 是否允许 prompt=none 静默重登
BFF_SSO_SILENT_RELOGIN=true
# exchange 请求超时 / provider 元数据缓存
BFF_SSO_EXCHANGE_TIMEOUT_MS=10000
BFF_SSO_PROVIDER_CACHE_MS=30000
# 仅本地联调：允许 http origin（生产禁止）
BFF_ALLOW_INSECURE_SSO=false

# Intellect RAG 后端 origin(社区版认证透传、/proxy/v1、动态 admin 登录)
INTELLECT_RAG_URL=http://localhost:9380
PYTHON_ADMIN_PORT=9381

# CORS 允许的前端来源(逗号分隔)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9391

# SSRF 防护:是否允许向私有网段(10.x / 172.16-31.x / 192.168.x / 127.x / 169.254.x)发起请求
# 内部/实验室部署的后端通常位于私有网段,设为 true 放行 wizard 探测与 setup。
# 默认 false(拦截);公网暴露的 BFF 切勿开启。
SSRF_ALLOW_PRIVATE_IP=false

# 方案 A:企业版画布/agents 的 imt_ 透传开关(默认 true)。
# 开启后 /canvas/* 与 /agents/* 挂上 authSessionMiddleware,企业版已登录请求
# 以 imt_(而非 RAG 超管 JWT)访问 intellect-rag。
# 社区版请设 false,继续用 Authorization 头 + RAG 超管 JWT。
BFF_ENABLE_IMT_CANVAS_AGENTS=true

# 运行时插件安装/卸载 token(必填才启用 install/delete,fail-closed)
BFF_PLUGIN_INSTALL_TOKEN=
# 安装来源开关(逗号分隔,支持 local,zip;默认 local,zip,设为 local 收回 zip 上传)
BFF_PLUGIN_INSTALL_SOURCES=local,zip
# BFF 绑定地址(默认 127.0.0.1;容器部署按需 0.0.0.0)
BFF_HOST=127.0.0.1

# 是否信任前置反代(nginx)的 X-Forwarded-For / X-Real-IP,用于 wizard 限流的客户端 IP 识别。
# 仅反向代理形态设 true(nginx 已覆写该头);直连形态保持不设/false——转发头可被
# 客户端伪造,轮换该头即可绕过限流。默认 false(取真实 socket 地址)。
BFF_TRUST_PROXY=false

# P0-1 hiedu 门户断言代理(/api/bff/hiedu/*)
# 仅 HIEDU_AUTH_MODE=gateway 时启用;未设置时路由返回 503(不影响 BFF 启动)。
HIEDU_AUTH_MODE=
HIEDU_BASE_URL=
# 主签名密钥(PKCS#8 Ed25519 PEM;单行可用 \n 表示换行)
HIEDU_BFF_ASSERT_KID=
HIEDU_BFF_ASSERT_PRIVATE_KEY_PEM=
# 可选次密钥(双 kid 轮换;两项必须成对配置)
HIEDU_BFF_ASSERT_KID_NEXT=
HIEDU_BFF_ASSERT_PRIVATE_KEY_PEM_NEXT=
# 断言 claims 缺省值(iss 需与 hiedu 网关断言签发方一致;ttl 建议 ≤30s,缓解重放)
HIEDU_BFF_ASSERT_ISS=gateway
HIEDU_BFF_ASSERT_AUD=hiedu
HIEDU_ORG_CODE=wust
